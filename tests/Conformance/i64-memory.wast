;; SH-03 repository fixture: memory32 addresses and i64 values.
(module
  (memory (export "memory") 1)
  (global $g (export "g") (mut i64) (i64.const 0x8000000000000001))
  (global (export "fixed") i64 (i64.const 0x7fffffffffffffff))
  (data (i32.const 0) "\fe\dc\ba\98\76\54\32\10")
  (func (export "load") (param i32) (result i64) local.get 0 i64.load)
  (func (export "load8_s") (param i32) (result i64) local.get 0 i64.load8_s)
  (func (export "load8_u") (param i32) (result i64) local.get 0 i64.load8_u)
  (func (export "load16_s") (param i32) (result i64) local.get 0 i64.load16_s)
  (func (export "load16_u") (param i32) (result i64) local.get 0 i64.load16_u)
  (func (export "load32_s") (param i32) (result i64) local.get 0 i64.load32_s)
  (func (export "load32_u") (param i32) (result i64) local.get 0 i64.load32_u)
  (func (export "store") (param i32 i64) local.get 0 local.get 1 i64.store)
  (func (export "store8") (param i32 i64) local.get 0 local.get 1 i64.store8)
  (func (export "store16") (param i32 i64) local.get 0 local.get 1 i64.store16)
  (func (export "store32") (param i32 i64) local.get 0 local.get 1 i64.store32)
  (func (export "load_offset") (param i32) (result i64) local.get 0 i64.load offset=4294967295)
  (func (export "store_offset") (param i32 i64) local.get 0 local.get 1 i64.store offset=4294967295)
  (func (export "load_plus3") (param i32) (result i64) local.get 0 i64.load offset=3 align=1)
  (func (export "roundtrip") (param i64) (result i64)
    local.get 0 global.set $g
    i32.const 3 global.get $g i64.store align=1
    i32.const 3 i64.load align=1)
  (func (export "set_global") (param i64) local.get 0 global.set $g))
(assert_return (get "g") (i64.const 0x8000000000000001))
(assert_return (get "fixed") (i64.const 0x7fffffffffffffff))
(assert_return (invoke "load" (i32.const 0)) (i64.const 0x1032547698badcfe))
(assert_return (invoke "load" (i32.const 1)) (i64.const 0x001032547698badc))
(assert_return (invoke "load8_s" (i32.const 0)) (i64.const -2))
(assert_return (invoke "load8_u" (i32.const 0)) (i64.const 254))
(assert_return (invoke "load16_s" (i32.const 0)) (i64.const -8962))
(assert_return (invoke "load16_u" (i32.const 0)) (i64.const 0xdcfe))
(assert_return (invoke "load32_s" (i32.const 0)) (i64.const -1732584194))
(assert_return (invoke "load32_u" (i32.const 0)) (i64.const 0x98badcfe))
(assert_return (invoke "load" (i32.const 65528)) (i64.const 0))
(assert_trap (invoke "load" (i32.const 65529)) "out of bounds memory access")
(assert_trap (invoke "load" (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "load_offset" (i32.const 1)) "out of bounds memory access")
(assert_trap (invoke "store_offset" (i32.const 1) (i64.const -1)) "out of bounds memory access")
(assert_return (invoke "roundtrip" (i64.const 9007199254740993)) (i64.const 9007199254740993))
(assert_return (get "g") (i64.const 9007199254740993))
(assert_return (invoke "load_plus3" (i32.const 0)) (i64.const 9007199254740993))
(assert_return (invoke "store8" (i32.const 20) (i64.const -1)))
(assert_return (invoke "load" (i32.const 20)) (i64.const 255))
(assert_return (invoke "store16" (i32.const 21) (i64.const -1)))
(assert_return (invoke "load" (i32.const 20)) (i64.const 0xffffff))
(assert_return (invoke "store32" (i32.const 23) (i64.const -1)))
(assert_return (invoke "load" (i32.const 20)) (i64.const 0xffffffffffffff))
(assert_return (invoke "store" (i32.const 65528) (i64.const 0x8000000000000001)))
(assert_return (invoke "load" (i32.const 65528)) (i64.const 0x8000000000000001))
(assert_trap (invoke "store" (i32.const 65529) (i64.const -1)) "out of bounds memory access")
(assert_return (invoke "load" (i32.const 65528)) (i64.const 0x8000000000000001))
(assert_invalid (module (global i32 (i64.const 0))) "type mismatch")
(assert_invalid (module (global i64 (i32.const 0))) "type mismatch")
(assert_invalid (module (memory 1) (data (i64.const 0) "x")) "type mismatch")
(assert_invalid (module (memory 1) (func (param i64) (result i64) local.get 0 i64.load)) "type mismatch")
(assert_invalid (module (memory 1) (func (param i32 i32) local.get 0 local.get 1 i64.store)) "type mismatch")
(assert_invalid (module (memory 1) (func i32.const 0 i64.load align=16 drop)) "alignment must not be larger than natural")
